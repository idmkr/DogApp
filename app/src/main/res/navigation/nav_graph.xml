<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.dogapp.ui.main.MainFragment"
        android:label="Dog Breeds"
        tools:layout="@layout/fragment_main">

        <action
            android:id="@+id/action_main_to_details"
            app:destination="@id/detailsFragment" />

        <action
            android:id="@+id/action_main_to_favorites"
            app:destination="@id/favoriteFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.dogapp.ui.details.DetailsFragment"
        android:label="Breed Details"
        tools:layout="@layout/fragment_details">

        <!-- Добавляем action для возврата -->
        <action
            android:id="@+id/action_details_to_main"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/mainFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/favoriteFragment"
        android:name="com.example.dogapp.ui.favorite.FavoriteFragment"
        android:label="Favorites"
        tools:layout="@layout/fragment_favorite">

        <action
            android:id="@+id/action_favorites_to_details"
            app:destination="@id/detailsFragment" />
    </fragment>

</navigation>